AZURE_OPENAI_ENDPOINT=https://XYZ.openai.azure.com
# Laisser vide pour s'authentifier par Entra ID (az login / identité managée), la cible du M4.
AZURE_OPENAI_API_KEY=REMPLACER_PAR_VOTRE_CLE_AZURE
# Noms des DÉPLOIEMENTS (pas des modèles) créés dans Azure AI Foundry
CHAT_DEPLOYMENT=gpt-5.4-mini-2
# Optionnel : identifiant Hugging Face ou dossier de modele local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

MYSQL_HOST=localhost
MYSQL_PORT=3306
